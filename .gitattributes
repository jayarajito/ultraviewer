# Files that run on LINUX (CI runners, containers) must keep LF line endings even when
# committed from a Windows checkout with core.autocrlf=false - a stray CR breaks
# "#!/usr/bin/env bash" and shell snippets inside YAML.
* text=auto
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.tpl       text eol=lf
*.json      text eol=lf
Dockerfile* text eol=lf
*.dockerignore text eol=lf
# Windows-only helper scripts keep CRLF.
*.ps1       text eol=crlf
*.bat       text eol=crlf
